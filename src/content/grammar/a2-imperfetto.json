{
  "id": "a2-imperfetto",
  "level": "A2",
  "order": 2,
  "title": "L'imparfait : imperfetto",
  "summary": "Décrire, raconter les habitudes et le décor du passé.",
  "blocks": [
    { "type": "p", "text": "L'imperfetto décrit une situation, une habitude ou une action en cours dans le passé. Le passato prossimo raconte les événements ponctuels." },
    { "type": "table", "caption": "Formation régulière", "head": ["Personne", "parlare", "avere", "dormire"], "rows": [["io", "parlavo", "avevo", "dormivo"], ["tu", "parlavi", "avevi", "dormivi"], ["lui, lei", "parlava", "aveva", "dormiva"], ["noi", "parlavamo", "avevamo", "dormivamo"], ["voi", "parlavate", "avevate", "dormivate"], ["loro", "parlavano", "avevano", "dormivano"]] },
    { "type": "rule", "text": "Essere est irrégulier : ero, eri, era, eravamo, eravate, erano. Fare → facevo, dire → dicevo, bere → bevevo." },
    { "type": "tip", "text": "Décor (imperfetto) + événement (passato prossimo) : Mentre leggevo, è suonato il telefono." },
    { "type": "examples", "items": [{ "it": "Da bambino andavo al mare con i nonni.", "fr": "Enfant, j'allais à la mer avec mes grands-parents." }, { "it": "Era tardi e pioveva.", "fr": "Il était tard et il pleuvait." }] }
  ],
  "exercises": [
    { "id": "e1", "type": "choice", "prompt": "Complète.", "text": "Quando ero piccola, ___ sempre i cartoni animati.", "options": ["guardavo", "ho guardato", "guardo", "guarderò"], "answer": 0, "explanation": "Habitude passée : imperfetto." },
    { "id": "e2", "type": "choice", "prompt": "Complète.", "text": "Mentre ___ la cena, è arrivato Luca.", "options": ["ho preparato", "preparavo", "preparo", "preparerei"], "answer": 1, "explanation": "Action en cours interrompue : imperfetto." },
    { "id": "e3", "type": "choice", "prompt": "Complète.", "text": "Ieri sera ___ molto stanco.", "options": ["sarò", "sono", "ero", "erano"], "answer": 2, "explanation": "État dans le passé : ero." },
    { "id": "e4", "type": "choice", "prompt": "Complète.", "text": "Ieri ___ il treno delle otto.", "options": ["prendevo", "prendo", "prendevamo", "ho preso"], "answer": 3, "explanation": "Événement ponctuel daté : passato prossimo." },
    { "id": "e5", "type": "cloze", "prompt": "Conjugue fare (noi).", "text": "Da giovani ___ lunghe passeggiate.", "answers": ["facevamo"], "explanation": "Fare → facevamo." }
  ]
}
